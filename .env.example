# UCI Exam Prep Platform - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials

# Server Port
PORT=5000

# PostgreSQL Database Connection String (Supabase / Neon / Render / Local PostgreSQL)
# Example: postgresql://postgres:your_password@localhost:5432/uci_exam
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Session Secret for signing tokens (minimum 32 random characters recommended)
SESSION_SECRET=your_long_random_session_secret_key_here

# Timezone (Defaults to Asia/Kolkata for Indian competitive exams)
TZ=Asia/Kolkata

# Google Gemini API Key (Optional: for AI Mock Test Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Seed Admin Account Credentials (for initial admin user creation via `pnpm seed:admin`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@uci.edu
ADMIN_MOBILE=+919876543210
ADMIN_PASSWORD=your_secure_admin_password_12_chars
