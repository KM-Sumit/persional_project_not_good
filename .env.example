# Local Postgres from compose.local.yaml (host port 5436).
DATABASE_URL=postgres://uci:uci@localhost:5436/uci
# Migrations skip PgBouncer. Locally this is the same database.
MIGRATION_DATABASE_URL=postgres://uci:uci@localhost:5436/uci
# Valkey. Unset: cache and rate limits stay in this process.
REDIS_URL=redis://localhost:6382

# openssl rand -base64 32
AUTH_SECRET=
# Public origin. Used for the Google redirect URI.
ORIGIN=http://localhost:5173

# Comma-separated Google emails that become admins on sign-in.
ADMIN_EMAILS=admin@uci.test

# Google OAuth web client. Both required for the real button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 = dev-only account chooser. Ignored when NODE_ENV is production.
GOOGLE_OAUTH_MOCK=1

# Question drafting. Direct Gemini runs first. OpenRouter is used only if Gemini fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=

# Private Cloudflare R2 bucket. All four required, or uploads say storage is not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uci

# Dev only: set to off for local browser test runs (ignored in production).
RATE_LIMIT=

# AI model for question generation (Gemini first; OpenRouter is the fallback). See docs/AI.md.
GEMINI_MODEL=gemini-3-flash-preview

# Web Push. Generate with: bun scripts/vapid.ts (writes these into .env).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Razorpay. Checkout stays off until all three are set. Webhook URL: ${ORIGIN}/api/razorpay/webhook
# (events: payment.captured, order.paid, payment.failed). Use rzp_test_* keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
