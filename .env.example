# Local Postgres from compose.local.yaml (host port 5436).
DATABASE_URL=postgres://uci:uci@localhost:5436/uci
# Migrations skip PgBouncer. Locally this is the same database.
MIGRATION_DATABASE_URL=postgres://uci:uci@localhost:5436/uci
# Valkey. Unset: cache and rate limits stay in this process.
REDIS_URL=redis://localhost:6382

# openssl rand -base64 32
AUTH_SECRET=
# Public origin. Used for the Google redirect URI.
ORIGIN=http://localhost:5173

# Comma-separated Google emails that become admins on sign-in.
ADMIN_EMAILS=admin@uci.test

# Google OAuth web client. Both required for the real button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 = dev-only account chooser. Ignored when NODE_ENV is production.
GOOGLE_OAUTH_MOCK=1

# Question drafting. Direct Gemini runs first. OpenRouter is used only if Gemini fails.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=

# Private Cloudflare R2 bucket. All four required, or uploads say storage is not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uci
