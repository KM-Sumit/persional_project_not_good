{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm --filter \"./artifacts/api-server\" --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter \"./artifacts/api-server\" --filter \"./artifacts/uci-education\" --if-present run typecheck",
    "dev:server": "pnpm --filter @workspace/api-server run build && node --env-file=.env artifacts/api-server/dist/index.mjs",
    "start:server": "node --env-file=.env artifacts/api-server/dist/index.mjs",
    "dev:web": "pnpm --filter @workspace/uci-education exec expo start --web --port 8081",
    "dev:mobile": "pnpm --filter @workspace/uci-education exec expo start",
    "build:server": "pnpm --filter @workspace/api-server run build",
    "build:web": "pnpm --filter @workspace/uci-education run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:migrate": "pnpm --filter @workspace/api-server run migrate",
    "seed:admin": "pnpm --filter @workspace/api-server run seed:admin",
    "seed:content": "pnpm --filter @workspace/api-server run seed:content"
  },
  "private": true,
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
