{
	"name": "uci",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev --port 5174 --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "bun server.js",
		"test": "bun test",
		"db:up": "docker compose -f compose.local.yaml up -d --wait",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:seed": "bun scripts/seed.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.3",
		"drizzle-kit": "^0.31.11",
		"playwright": "1.57.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.55.0",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.12",
		"katex": "0.16.11",
		"postgres": "^3.4.9",
		"unpdf": "1.8.1",
		"zod": "^4.6.6",
		"@langchain/core": "^1.2.19",
		"@langchain/openai": "^1.6.2",
		"@langchain/google-genai": "^1.0.0",
		"aws4fetch": "^1.0.20",
		"marked": "^18.1.1"
	}
}
